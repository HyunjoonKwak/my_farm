// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 사용자 ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  kakaoId       String?   @unique
  role          String    @default("USER") // "ADMIN" | "USER"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  retirementGoal    RetirementGoal?
  farmProfile       FarmProfile?
  setupCostItems    SetupCostItem[]
  fundingSources    FundingSource[]
  farmingLogs       FarmingLog[]
  crops             Crop[]
  transactions      FinancialTransaction[]
  inventory         InventoryItem[]
  priceWatchlist           PriceWatchlist[]
  priceAlerts              PriceAlert[]
  notifications            Notification[]
  productWatchlist         ProductWatchlist[]
  marketCollectionSettings MarketCollectionSettings?
  marketComparisonPresets MarketComparisonPreset[]
  briefingWorker BriefingWorkerCredential?
  briefingRuns BriefingRun[]
  weeklyBriefings WeeklyBriefing[]
  workReportImports WorkReportImport[]
  competitorSearches CompetitorSearch[]
  competitorPanel CompetitorPanelEntry[]
  competitorObservations CompetitorPriceObservation[]
  discoveryRuns CompetitorDiscoveryRun[]
  discoveryCandidates CompetitorDiscoveryCandidate[]
  collectionJobs CompetitorCollectionJob[]
}

// ==================== 스마트팜 준비 계획 ====================
model RetirementGoal {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  targetDate             DateTime // 퇴직 목표일
  estimatedRetirementPay Decimal? // DC 퇴직금 예상액
  estimatedSeverancePay  Decimal? // 퇴직수당 예상액
  initialLivingBuffer    Decimal? // 초기 생활비 버퍼
  bufferMonths           Int?     @default(6) // 버퍼 개월 수
  monthlyLivingExpense   Decimal? // 월 생활비 (버퍼 계산용)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== 농장 프로필 (온보딩 마법사) ====================
// 실재배 기록은 Crop이 담당한다. plannedCrops는 재배 예정 작물명 JSON 배열로,
// 실제 파종 시 작물 관리에서 Crop 행을 만든다 (예정 단계에선 날짜가 없으므로).
model FarmProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  region          String   // 지역 (시/도 + 시/군)
  farmingType     String   // OPEN_FIELD | GREENHOUSE | SMART_FARM | ORCHARD | MIXED
  areaPyeong      Decimal? // 재배(예정) 면적 (평)
  targetStartYear Int?     // 귀농 목표 연도
  plannedCrops    String   @default("[]") // 재배 예정 작물명 JSON 배열
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== 허브 순자산 캐시 (Asset Hub §2.4 소비자) ====================
// my_portal GET /api/assets/net-worth 응답을 통째로 캐시한다 (last-known-good).
// 단일 행(singleton) — 순자산 계산은 my_portal 소관이고 retirefarm은 재계산하지 않으므로
// 항목을 쪼개 저장할 이유가 없다. 쓰기 UI/API도 없다 (§1.5 지배 원칙).
model HubNetWorthCache {
  id          String   @id @default("singleton")
  netWorthKrw BigInt   // 계약의 net_worth_krw 원본값 (정수, 원)
  asOf        DateTime // 허브 집계 시각 (부분 소스 시각은 payload.sources에)
  collectedAt DateTime @default(now())
  payload     String   // §2.4 응답 원문 JSON (assets·liabilities·sources)
}

// ==================== 설립 비용 ====================
model SetupCostCategory {
  id            String                @id @default(cuid())
  name          String
  order         Int                   @default(0)
  subcategories SetupCostSubcategory[]
}

model SetupCostSubcategory {
  id         String            @id @default(cuid())
  categoryId String
  name       String
  order      Int               @default(0)

  category SetupCostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    SetupCostItem[]
}

model SetupCostItem {
  id               String     @id @default(cuid())
  userId           String
  subcategoryId    String
  name             String
  description      String?
  estimatedCost    Decimal
  actualCost       Decimal?
  quantity         Int        @default(1)
  unit             String     @default("개")
  areaInPyeong     Decimal?   // 면적 (평)
  pricePerPyeong   Decimal?   // 평단가 (원)
  personCount      Int?       // 인원수 (인건비용)
  pricePerPerson   Decimal?   // 인당 단가 (인건비용)
  durationMonths   Int?       // 기간 (개월, 인건비용)
  isGovernmentSubsidy Boolean @default(false)
  subsidyAmount    Decimal?
  subsidyRate      Decimal?
  priority         String     @default("ESSENTIAL") // Priority enum -> String
  status           String     @default("PLANNED")   // ItemStatus enum -> String
  // 지출 예정일. null이면 현금흐름 예측에서 영농 시작 달(있으면) 또는 예측 첫 달로 폴백한다.
  // 기존 행은 null — 등록일(createdAt)로 과거를 추정하지 않는다.
  plannedDate      DateTime?
  // 지출일. 값이 있으면 이미 지출한 항목으로 보고 미래 유출에서 제외한다.
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategory SetupCostSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== 자금 조달 ====================
model FundingSource {
  id            String        @id @default(cuid())
  userId        String
  type          String        // FundingType enum -> String
  name          String
  amount        Decimal
  expectedDate  DateTime
  externalAssetId String?     @unique // asset_manager Portfolio id (원장은 asset_manager 소유, FK 없음)
  status        String        @default("PLANNED") // FundingStatus enum -> String
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== 영농일지 ====================
model FarmingLog {
  id          String         @id @default(cuid())
  userId      String
  date        DateTime
  temperature Decimal?
  humidity    Int?
  rainfall    Decimal?
  weather     String?
  notes       String?
  content     String?        // BlockNote 문서 JSON (자유 서술 본문)
  photos      String?        // String[] -> String (JSON 형식으로 저장)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities FarmActivity[]

  @@unique([userId, date])
}

model FarmActivity {
  id          String       @id @default(cuid())
  logId       String
  type        String       // ActivityType enum -> String
  cropId      String?
  plotId      String?
  description String
  quantity    Decimal?
  unit        String?
  duration    Int?
  workers     Int?
  createdAt   DateTime     @default(now())

  log            FarmingLog           @relation(fields: [logId], references: [id], onDelete: Cascade)
  crop           Crop?                @relation(fields: [cropId], references: [id], onDelete: SetNull)
  materialUsages MaterialUsage[]
}

model MaterialUsage {
  id         String   @id @default(cuid())
  activityId String
  itemId     String
  quantity   Decimal

  activity FarmActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ==================== 작물 ====================
model Crop {
  id                  String      @id @default(cuid())
  userId              String
  name                String
  variety             String?
  plantingDate        DateTime
  expectedHarvestDate DateTime
  plotId              String?
  status              String      @default("GROWING")  // CropStatus enum -> String
  growthStage         String      @default("SEEDING")  // GrowthStage enum -> String
  // 재배 종료일. COMPLETED/FAILED로 전이될 때 서버가 기록하고 사용자가 교정할 수 있다.
  // 기존 종료 행은 null — 보고서는 updatedAt으로 폴백하며 추정치로 표시한다 (backfill 없음).
  completedAt         DateTime?
  completedAtEstimated Boolean @default(false) // 레거시 수정일 기반 추정 여부
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities   FarmActivity[]
  transactions FinancialTransaction[]

  @@index([userId, status])
}

// ==================== 재무 ====================
model FinancialTransaction {
  id            String          @id @default(cuid())
  userId        String
  date          DateTime
  type          String          // TransactionType enum -> String
  category      String
  subcategory   String?
  amount        Decimal
  description   String
  relatedCropId String?
  paymentMethod String?
  receiptUrl    String?
  createdAt     DateTime        @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop Crop? @relation(fields: [relatedCropId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// ==================== 재고 ====================
model InventoryItem {
  id               String            @id @default(cuid())
  userId           String
  name             String
  category         String            // InventoryCategory enum -> String
  currentQuantity  Decimal
  unit             String
  minimumQuantity  Decimal           @default(0)
  lastPurchaseDate DateTime?
  lastPurchasePrice Decimal?
  location         String?
  expirationDate   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   InventoryTransaction[]
  materialUsages MaterialUsage[]

  @@index([userId])
}

model InventoryTransaction {
  id       String   @id @default(cuid())
  itemId   String
  type     String   // "IN" | "OUT"
  quantity Decimal
  date     DateTime
  reason   String

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ==================== 시세 정보 ====================

// 가락시장 경매결과
model AuctionResult {
  id            String   @id @default(cuid())
  productName   String   // PUMMOK 품목명
  variety       String   @default("") // PUMJONG 품종명 (빈 문자열 = 없음)
  tempName      String?  // PUM_NAME_IMSI 임시품목명
  unit          String   // UUN 거래단량
  grade         String   @default("") // DDD 등급 (빈 문자열 = 없음)
  price         Int      // PPRICE 경락가
  origin        String   @default("") // SSANGI 산지명 (빈 문자열 = 없음)
  corporation   String   // CORP_NM 법인명
  corporationCode String // 법인코드
  auctionDate   DateTime // ADJ_DT 경매일자
  quantity      Int      @default(1) // QTY 수량
  certification String?  // INJUNG_GUBUN 인증구분
  createdAt     DateTime @default(now())

  // 단위/등급/수량이 다른 별개 낙찰 건이 중복으로 버려지지 않도록 키에 포함
  @@unique([productName, variety, corporation, auctionDate, price, origin, unit, grade, quantity])
  @@index([productName, auctionDate])
  @@index([auctionDate])
  @@index([origin])
  // 품목별 품종·산지 목록 집계를 인덱스만으로 끝내기 위한 커버링 인덱스
  @@index([productName, variety])
  @@index([productName, origin])
}

// 관심 품목 (가락시장용)
model ProductWatchlist {
  id          String   @id @default(cuid())
  userId      String
  productName String   // 품목명 (토마토, 딸기 등)
  variety     String   @default("") // 품종명 (대추빨강 등) - 빈 문자열이면 전체
  origin      String   @default("") // 산지명 - 빈 문자열이면 전체
  targetPrice Int?     // 목표가격 (알림용)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productName, variety, origin])
}

// 데이터 수집 로그
model DataCollectionLog {
  id              String   @id @default(cuid())
  targetDate      DateTime // 수집 대상 일자
  corporation     String   // 법인코드
  targetProducts  String?  // 수집 대상 품목 (쉼표 구분, null=전체)
  totalCount      Int      // 총 조회 건수 (API에서 가져온 건수)
  newCount        Int      // 신규 저장 건수 (실제 DB 저장 건수)
  duplicateCount  Int      @default(0) // 중복으로 건너뛴 건수
  status          String   // SUCCESS, FAILED, PARTIAL
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([targetDate])
  @@index([status])
}

// 시세 수집 설정
model MarketCollectionSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // 자동 수집 설정
  autoCollectEnabled  Boolean  @default(false)
  collectTime         String   @default("09:30") // HH:mm 형식
  collectDaysAgo      Int      @default(0) // 몇 일 전 데이터 수집 (0=오늘, 1=어제)
  collectDays         String   @default("1,2,3,4,5") // 수집할 요일 (0=일,1=월,...,6=토, 쉼표 구분)
  // 수집 대상
  corporationCodes    String   @default("11000101") // 쉼표로 구분
  targetProducts      String   @default("토마토,포도") // 수집 대상 품목 (쉼표로 구분)
  // 데이터 보관 설정
  retentionDays       Int      @default(90) // 보관 기간 (일)
  autoCleanupEnabled  Boolean  @default(true) // 자동 정리 활성화
  // 조회 설정
  defaultViewDays     Int      @default(30) // 기본 조회 기간
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // 텔레그램 일일 요약 (발송 항목은 digestItems)
  digestEnabled       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryJobs MarketRecoveryJob[]
  digestItems  MarketDigestItem[]
}

// 일일 요약에 넣을 항목 — 같은 품종이 여러 이름으로 기록되므로 품종은 목록으로 받는다
model MarketDigestItem {
  id          String   @id @default(cuid())
  settingsId  String
  productName String   // 가락시장 품목명 (MARKET_PRODUCTS)
  label       String   @default("") // 표시 이름 (빈 문자열 = 품목명)
  varieties   String   @default("[]") // JSON 문자열 배열, 빈 배열 = 그날 물량 최다 품종 자동
  origin      String   @default("") // 산지명 (빈 문자열 = 전체 산지). 그날 거래가 없으면 전체 산지로 대체
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings MarketCollectionSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, sortOrder])
}

// 자동 보충의 시도 횟수와 실행 소유권은 재시작 후에도 유지한다.
model MarketRecoveryJob {
  id            String   @id @default(cuid())
  settingsId    String
  scope         String
  targetDate    String
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken    String?
  leaseUntil    DateTime?
  lastError     String?
  notifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  settings MarketCollectionSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, scope, targetDate])
  @@index([status, nextAttemptAt])
}

model PriceWatchlist {
  id       String @id @default(cuid())
  userId   String
  itemCode String
  itemName String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemCode])
}

model PriceAlert {
  id          String  @id @default(cuid())
  userId      String
  itemCode    String
  itemName    String
  condition   String  // "ABOVE" | "BELOW"
  targetPrice Decimal
  isActive    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketPriceCache {
  id            String   @id @default(cuid())
  itemCode      String
  itemName      String
  marketCode    String
  marketName    String
  date          DateTime
  avgPrice      Decimal
  maxPrice      Decimal
  minPrice      Decimal
  tradingVolume Decimal
  unit          String
  fetchedAt     DateTime @default(now())

  @@unique([itemCode, marketCode, date])
  @@index([itemCode, date])
}

// ==================== 알림 ====================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      String           // NotificationType enum -> String
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// 사용자별 비교 조건. 원문 필터 값을 보존하고 추정 별칭은 병합하지 않는다.
model MarketComparisonPreset {
  id          String @id @default(cuid())
  userId      String
  name        String
  productName String
  varieties   String @default("[]")
  origin      String?
  unit        String?
  grade       String?
  createdAt   DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

// 서버는 토큰 해시만 보관한다. 토큰 원문은 발급 응답에서 한 번만 제공한다.
model BriefingWorkerCredential {
  id String @id @default(cuid())
  userId String @unique
  tokenHash String @unique
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BriefingRun {
  id String @id @default(cuid())
  userId String
  weekStart DateTime
  inputHash String
  snapshot String
  status String @default("PENDING")
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  credentialId String?
  lastError String?
  resultHash String?
  usage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefing WeeklyBriefing?
  @@unique([userId, weekStart, inputHash])
  @@index([userId, status, createdAt])
}

model WeeklyBriefing {
  id String @id @default(cuid())
  userId String
  runId String @unique
  status String @default("DRAFT")
  body String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  run BriefingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

// Immutable imported Work reports and correction lineage; public reference prices never become auction trades.
model WorkReportImport {
  id String @id @default(cuid())
  userId String
  title String
  periodStart DateTime?
  periodEnd DateTime?
  sourceUrl String?
  rawMarkdown String
  rawJson String?
  normalized String?
  contentHash String
  parentId String?
  correctionReason String?
  version Int @default(1)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent WorkReportImport? @relation("WorkImportVersions", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  corrections WorkReportImport[] @relation("WorkImportVersions")
  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

model CompetitorSearch {
  id String @id @default(cuid())
  userId String
  query String
  bucket String
  status String @default("RUNNING")
  response String?
  errorCode String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, query, bucket])
  @@index([userId, createdAt])
}

model CompetitorPanelEntry {
  id String @id @default(cuid())
  userId String
  storeKey String
  // Legacy per-store active marker (kept for older readers); several active options per store are allowed, so it is no longer unique.
  activeStoreKey String?
  // SHA-256 of canonical productUrl + trimmed optionLabel + packageKg while active, "legacy:<id>" for rows backfilled by the migration, null once archived.
  activeOptionKey String?
  storeName String
  productUrl String
  productName String @default("토마토")
  varietyGroup String
  qualityGroup String
  optionLabel String
  packageKg Float
  sizeGrade String @default("UNKNOWN")
  sizeCriteria String @default("")
  cultivarName String @default("")
  color String @default("UNKNOWN")
  mixture String @default("UNKNOWN")
  processing String @default("UNKNOWN")
  createdAt DateTime @default(now())
  archivedAt DateTime?
  archiveReason String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations CompetitorPriceObservation[]
  @@unique([userId, activeOptionKey])
  @@index([userId, activeStoreKey])
  @@index([userId, createdAt])
}

model CompetitorPriceObservation {
  id String @id @default(cuid())
  userId String
  entryId String
  observedAt DateTime
  price Int?
  shippingFee Int?
  availability String
  notes String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry CompetitorPanelEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([userId, observedAt])
  @@index([entryId, observedAt])
}

model CompetitorDiscoveryRun {
  id String @id @default(cuid())
  userId String
  contentHash String
  evidenceCount Int
  source String @default("MANUAL_PUBLIC_SEARCH")
  policyVersion String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence CompetitorDiscoveryEvidence[]
  collectionJob CompetitorCollectionJob?
  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

model CompetitorDiscoveryCandidate {
  id String @id @default(cuid())
  userId String
  productUrl String
  storeKey String
  storeName String
  title String
  status String @default("WATCH")
  decisionReason String?
  lastSeenAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence CompetitorDiscoveryEvidence[]
  decisions CompetitorDiscoveryDecision[]
  @@unique([userId, productUrl])
  @@index([userId, lastSeenAt])
}

model CompetitorDiscoveryEvidence {
  id String @id @default(cuid())
  candidateId String
  runId String
  query String
  observedAt DateTime
  payload String
  contentHash String
  candidate CompetitorDiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  run CompetitorDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([candidateId, query, observedAt])
  @@index([candidateId, observedAt])
}

model CompetitorDiscoveryDecision {
  id String @id @default(cuid())
  candidateId String
  status String
  reason String
  createdAt DateTime @default(now())
  candidate CompetitorDiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@index([candidateId, createdAt])
}

// 사용자가 직접 진행하는 경쟁사 검색 수집 작업. 스케줄러·자동 재시도·타임아웃 없음:
// start/resume/block/cancel은 사용자 신호이고, SUCCEEDED는 검토한 자료를 저장한 discovery import가 같은 트랜잭션에서 기록한다.
model CompetitorCollectionJob {
  id String @id @default(cuid())
  userId String
  weekStart DateTime // KST 월요일 00:00 (UTC instant); 같은 주·같은 검색어는 한 작업
  query String // 정규화된 검색어 (discovery evidence.query와 동일 규칙)
  searchUrl String
  status String @default("PENDING") // PENDING | RUNNING | BLOCKED | SUCCEEDED | CANCELLED
  reason String? // BLOCKED 사유
  version Int @default(1)
  evidenceCount Int @default(0)
  runId String? @unique
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  run CompetitorDiscoveryRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@unique([userId, weekStart, query])
  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status, completedAt])
}

// 일일 시세 요약 발송 이력 (채널·날짜당 1건 — 발송 전에 점유해 중복 발송 방지)
model MarketDigestDelivery {
  id        String   @id @default(cuid())
  channel   String   // telegram
  dateKey   String   // YYYY-MM-DD (KST 경매일)
  status    String   // SENDING, SENT, EMPTY_SENT(0건 요약 — 거래 수집 시 재발송), FAILED, UNKNOWN
  messageId String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, dateKey])
}
