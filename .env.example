# Database (SQLite)
DATABASE_URL="file:./data/retirefarm.db"

# 로컬 개발용 데이터 디렉토리
DATA_PATH="./data"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3024"

# Kakao OAuth
KAKAO_CLIENT_ID="your_kakao_client_id"
KAKAO_CLIENT_SECRET="your_kakao_client_secret"
# 관리자로 등록할 카카오 사용자 ID. 미설정 시 신규 사용자는 USER.
KAKAO_ADMIN_ID=""
# 기존 ADMIN 계정에 연결할 때만 지정 (기존 계정 ID).
KAKAO_ADMIN_USER_ID=""

# Garak Market API (가락시장 공공데이터)
GARAK_API_ID="your_garak_api_id"
GARAK_API_PASSWORD="your_garak_api_password"
# 필요 시 HTTPS 주소로만 재정의할 수 있습니다. HTTP 및 리다이렉트는 허용하지 않습니다.
GARAK_API_URL="https://www.garak.co.kr/homepage/publicdata/dataOpen.do"

# 일일 시세 요약 텔레그램 발송 (둘 다 비우면 발송 안 함)
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cron endpoint protection (외부 크론 호출 보호용 시크릿)
CRON_SECRET="your_random_secret"

# External Portfolio API (asset_manager 물건 상세 연동 — 레거시 per-item API)
EXTERNAL_PORTFOLIO_API_URL="https://your-asset-manager"
EXTERNAL_PORTFOLIO_API_KEY="your_service_api_key"

# 자본 게이지 — 허브 순자산 단일 소스 (Asset Hub Integration §2.4)
# 순자산 계산은 my_portal에만 존재한다. 부분 소스(portfolio/asset)를 직접 합산하면
# 현금·비부동산 부채가 빠지므로 반드시 이 API 하나만 소비한다.
# 토큰 발급: my_portal `python scripts/issue_snapshot_consumer_token.py issue`
MY_PORTAL_URL="https://your-my-portal"
MY_PORTAL_SNAPSHOT_TOKEN="your_consumer_token"

# 매도 시뮬레이션 — asset_manager 직접 연결 (§1.5.3, 자본 게이지와 별개 경로)
ASSET_MANAGER_URL="https://your-asset-manager"
ASSET_MANAGER_SNAPSHOT_TOKEN="your_asset_snapshot_token"

# 클라이언트 딥링크 (소유 서비스로 이동 — Asset Hub §1.5 single writer)
NEXT_PUBLIC_ASSET_MANAGER_URL="https://your-asset-manager"

# Backup
BACKUP_DIR="./backups"
# Docker 호스트의 백업 폴더. 컨테이너 내부 경로는 /backups로 고정.
BACKUP_PATH="./backups"

# GHCR (GitHub Container Registry — 배포용)
GHCR_TOKEN="ghp_your_github_personal_access_token"
GHCR_USERNAME="your_github_username"

# Logging (선택: 프로덕션에서 info 로그 출력)
# LOG_VERBOSE="true"
